PORT=3000
NODE_ENV=development

# Firebase Admin SDK (descargar desde Firebase Console > Configuración del proyecto > Cuentas de servicio)
FIREBASE_PROJECT_ID=zonapc-builder
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@zonapc-builder.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_DATABASE_URL=https://zonapc-builder-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=zonapc-builder.appspot.com

# FCM para notificaciones push (incluido en Firebase Admin)
FCM_SERVER_KEY=your_fcm_server_key

# JWT Secret (para tokens de sesión adicionales si se necesita)
JWT_SECRET=zonapc_secret_key_super_segura_2024
JWT_EXPIRES_IN=7d

# Configuración de la app
MAX_BUDGET=50000
MIN_BUDGET=500
DEFAULT_CURRENCY=GTQ
